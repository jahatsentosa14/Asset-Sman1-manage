# =====================================================================
# ENVIRONMENT VARIABLES
# Salin file ini menjadi ".env.local" lalu isi nilainya masing-masing.
# JANGAN pernah commit file ".env.local" ke GitHub (sudah otomatis
# diabaikan lewat .gitignore).
# =====================================================================

# --- NEXT_PUBLIC_SUPABASE_URL ---
# Fungsi : Alamat API project Supabase Anda. Dipakai frontend & backend
#          untuk menghubungi database dan auth.
# Asal   : Dashboard Supabase -> pilih project Anda -> Settings -> API
#          -> bagian "Project URL".
# Aman ditampilkan di browser? Ya (makanya prefix NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=

# --- NEXT_PUBLIC_SUPABASE_ANON_KEY ---
# Fungsi : Kunci publik untuk akses Supabase dari browser. Keamanan
#          data TETAP terjaga karena dibatasi oleh Row Level Security
#          (lihat database/02_rls_policies.sql) — kunci ini TIDAK bisa
#          dipakai untuk membaca data yang tidak diizinkan RLS.
# Asal   : Dashboard Supabase -> Settings -> API -> bagian
#          "Project API keys" -> baris "anon public".
# Aman ditampilkan di browser? Ya.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SUPABASE_SERVICE_ROLE_KEY ---
# Fungsi : Kunci rahasia yang MELEWATI Row Level Security sepenuhnya.
#          Dipakai di server untuk: (1) fitur "Buat Akun Guru/Admin" di
#          Admin Dashboard (lib/supabase/admin.ts), dan (2) proses server
#          terpisah seperti Discord bot. TIDAK PERNAH dipakai di kode yang
#          jalan di browser.
# Asal   : Dashboard Supabase -> Settings -> API -> "Project API keys"
#          -> baris "service_role".
# Aman ditampilkan di browser? TIDAK. Jika bocor, siapa pun bisa baca/
#          ubah SELURUH data tanpa batasan. Wajib diisi juga di Vercel
#          Environment Variables saat deploy (lihat documentation/deployment.md).
SUPABASE_SERVICE_ROLE_KEY=

# --- DISCORD_BOT_TOKEN ---
# Fungsi : Token untuk menjalankan Discord bot notifikasi approval.
# Asal   : https://discord.com/developers/applications -> pilih/buat
#          aplikasi -> menu "Bot" -> tombol "Reset Token" -> copy token.
# Aman ditampilkan di browser? TIDAK. Hanya disimpan di hosting bot
#          (Pterodactyl/Wispbyte), bukan di project Next.js/Vercel.
DISCORD_BOT_TOKEN=

# --- DISCORD_APPROVAL_CHANNEL_ID ---
# Fungsi : ID channel Discord tempat bot mengirim notifikasi approval.
# Asal   : Di Discord, aktifkan "Developer Mode" (User Settings -> Advanced),
#          lalu klik-kanan channel yang dituju -> "Copy Channel ID".
DISCORD_APPROVAL_CHANNEL_ID=
