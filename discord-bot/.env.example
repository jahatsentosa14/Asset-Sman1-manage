# =====================================================================
# Salin file ini menjadi ".env" (bukan ".env.local" seperti project Next.js)
# lalu isi nilainya. JANGAN commit file ".env" ke GitHub.
# =====================================================================

# --- SUPABASE_URL ---
# Sama persis dengan NEXT_PUBLIC_SUPABASE_URL di project Next.js utama.
# Asal: Dashboard Supabase -> Settings -> API -> "Project URL".
SUPABASE_URL=

# --- SUPABASE_SERVICE_ROLE_KEY ---
# Kunci rahasia yang melewati Row Level Security sepenuhnya. Bot butuh ini
# karena bot BUKAN pengguna aplikasi yang login — dia proses server terpisah.
# Asal: Dashboard Supabase -> Settings -> API -> "service_role".
# JANGAN PERNAH taruh key ini di kode Next.js yang jalan di browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- DISCORD_BOT_TOKEN ---
# Token bot Discord Anda.
# Asal: https://discord.com/developers/applications -> pilih aplikasi Anda
# -> menu "Bot" di sidebar kiri -> tombol "Reset Token" -> copy.
DISCORD_BOT_TOKEN=

# --- DISCORD_APPROVAL_CHANNEL_ID ---
# ID channel Discord tempat notifikasi approval dikirim.
# Cara mendapatkan: di Discord, buka User Settings -> Advanced -> aktifkan
# "Developer Mode". Lalu klik-kanan channel yang dituju -> "Copy Channel ID".
DISCORD_APPROVAL_CHANNEL_ID=

# --- DISCORD_MENTION_USER_IDS ---
# (Opsional) Daftar User ID Discord yang di-mention di setiap notifikasi
# approval baru, dipisah koma. Contoh: 111111111111111111,222222222222222222
# Cara mendapatkan ID user: klik-kanan nama user di Discord (Developer Mode
# harus aktif, lihat langkah di atas) -> "Copy User ID".
# Kosongkan jika tidak perlu mention siapa pun.
DISCORD_MENTION_USER_IDS=
